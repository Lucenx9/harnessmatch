{
  "name": "harnessmatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run check:output",
    "start": "next start",
    "lint": "biome lint . --error-on-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check:output": "node scripts/check-static-output.mjs",
    "check:sources": "node scripts/check-source-health.mjs",
    "sync:openrouter": "node scripts/sync-openrouter-attribution.mjs",
    "sync:ecosystem": "node scripts/sync-ecosystem-signals.mjs",
    "sync:gui-signals": "node scripts/sync-gui-ecosystem-signals.mjs",
    "sync:releases": "node scripts/sync-release-signals.mjs",
    "sync:usage": "npm run sync:openrouter && npm run sync:ecosystem && npm run sync:gui-signals && npm run sync:releases",
    "triage:releases": "node scripts/triage-release-updates.mjs",
    "verify": "npm run typecheck && npm run lint && npm run coverage && npm run build",
    "verify:maintenance": "npm run check:sources && npm run verify"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/analytics": "^2.0.1",
    "next": "16.2.12",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/coverage-v8": "^4.1.10",
    "agent-browser": "^0.33.0",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "vitest": "latest"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.24",
      "sharp": "0.35.3"
    }
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
